---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { AREA_LABEL, PATH_STAGES, TYPE_LABEL } from '../lib/labels';
import { AREA_ICON } from '../lib/icons';

const all = await getCollection('startups');
// Drafts show only while developing, or when PUBLIC_SHOW_DRAFTS=1.
const showDrafts = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_DRAFTS === '1';
const startups = all
  .filter((s) => showDrafts || !s.data.draft)
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'en', { sensitivity: 'base' }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Every number on this page is quoted from a source I read. Numbered in order of first use.
const refs = [
  {
    citation:
      'National Academies of Sciences, Engineering, and Medicine, news release, 5 Dec 2024: "To Advance Women’s Health Research, NIH Should Form New Institute and Congress Should Appropriate New Funding."',
    url: 'https://www.nationalacademies.org/news/to-advance-womens-health-research-nih-should-form-new-institute-and-congress-should-appropriate-new-funding-says-report',
    use: 'Read in full',
  },
  {
    citation: 'Nature Reviews Bioengineering, 2024 editorial: "Funding research on women’s health."',
    url: 'https://www.nature.com/articles/s44222-024-00253-7',
    use: 'Read in full. The editorial cites other sources for these figures (Moley 2024 for the 2020 R&D split; Horne & Missmer 2022 for endometriosis).',
  },
  {
    citation: 'Institute for Health Metrics and Evaluation (IHME), news release, 21 Jul 2026: "People are living longer but spending more years in poor health" (Global Burden of Disease 2023 study, The Lancet Public Health).',
    url: 'https://www.healthdata.org/news-events/newsroom/news-releases/people-are-living-longer-spending-more-years-poor-health',
    use: 'Press release read in full. The journal paper itself not read.',
  },
  {
    citation: 'IHME, news release, 1 May 2024: "The Lancet Public Health: Global study reveals stark differences between females and males in major causes of disease burden" (Global Burden of Disease 2021 study).',
    url: 'https://www.healthdata.org/news-events/newsroom/news-releases/lancet-public-health-global-study-reveals-stark-differences',
    use: 'Press release read in full. The journal paper itself not read.',
  },
  {
    citation: 'Partnership for Maternal, Newborn & Child Health (PMNCH, WHO), summary page for the World Economic Forum and McKinsey Health Institute report "Closing the Women\u2019s Health Gap."',
    url: 'https://pmnch.who.int/resources/publications/m/item/closing-the-women-s-health-gap',
    use: 'Summary page read in full. The report itself not read.',
  },
  {
    citation: 'World Health Organization, "Maternal mortality" fact sheet, 7 April 2025.',
    url: 'https://www.who.int/news-room/fact-sheets/detail/maternal-mortality',
    use: 'Read in full',
  },
];

// Each grid is 100 squares = 100% of its own total. Shares are quoted as the sources give them;
// the sources I read did not give the dollar totals, so none are shown.
const bars = [
  {
    big: '8.8%',
    total: 'all US government (NIH) research grant spending, 2013–2023',
    parts: [{ label: 'Women’s health research', pct: 8.8, kind: 'a' }],
    note: 'Share that focused on women’s health research.',
    ref: 1,
  },
  {
    big: '4% + 1%',
    total: 'global R&D funding, 2020',
    parts: [
      { label: 'Women’s cancers', pct: 4, kind: 'a' },
      { label: 'All other women-specific conditions', pct: 1, kind: 'b' },
    ],
    note: 'A quarter of the 1% went to fertility.',
    ref: 2,
  },
  {
    big: '3%',
    total: 'all digital health investment, 2021',
    parts: [{ label: 'Femtech companies', pct: 3, kind: 'a' }],
    note: 'About $2.5 billion went to femtech.',
    ref: 2,
  },
].map((b) => {
  // cell i covers the range [i, i+1) of the 100%; a part fills the share of the cell it overlaps
  let start = 0;
  const spans = b.parts.map((p) => {
    const s = { ...p, start, end: start + p.pct };
    start += p.pct;
    return s;
  });
  const cells = Array.from({ length: 100 }, (_, i) =>
    spans
      .map((p) => {
        const from = Math.max(p.start, i);
        const to = Math.min(p.end, i + 1);
        return to > from ? { kind: p.kind, x: (from - i) * 14, w: (to - from) * 14 } : null;
      })
      .filter(Boolean),
  );
  return { ...b, cells };
});

// Source [1] (National Academies) and [2] (Nature editorial) for these.
const FUND_W = 300;
const fundTotal = 4000 + 11400 + 315; // $ millions: $4B institute + $11.4B agency-wide fund + $315M workforce
let fx = 0;
const fund = [
  { label: '$4 billion', what: 'A new institute for women’s health', kind: 'a', v: 4000 },
  { label: '$11.4 billion', what: 'A fund for women’s health research across the agency', kind: 'b', v: 11400 },
  { label: '$315 million', what: 'Building the research workforce', kind: 'c', v: 315 },
].map((f) => {
  const w = (f.v / fundTotal) * FUND_W;
  const r = { ...f, x: fx, w };
  fx += w;
  return r;
});
const ten = (on) => Array.from({ length: 10 }, (_, i) => ({ x: 12 + i * 28, on: i < on }));
const SPLIT_W = 300;
let sx = 0;
const split = [
  { label: 'Women’s cancers', pct: '4%', v: 4, kind: 'a' },
  { label: 'Fertility (a quarter of the 1%)', pct: '0.25%', v: 0.25, kind: 'c' },
  { label: 'All other women-specific conditions', pct: '0.75%', v: 0.75, kind: 'b' },
].map((f) => {
  const w = (f.v / 5) * SPLIT_W;
  const r = { ...f, x: sx, w };
  sx += w;
  return r;
});
const femtechBar = bars[2];
const founders = ten(7);
const maternal = ten(9); // "about 9 in 10": WHO says about 92% of maternal deaths were in low and lower-middle-income countries
// IHME 2026 [3]: average years lived in poor health ("morbidity gap"), 2023.
const poorHealth = [
  { label: 'Women', v: 12.1, kind: 'b' },
  { label: 'Men', v: 9.3, kind: 'm' },
];
const poorHealthMax = 12.1;
// IHME 2024 [4]: age-standardised DALYs per 100,000, ages 10+, 2021.
const burden = [
  { name: 'Low back pain', f: 1265, m: 787 },
  { name: 'Depressive disorders', f: 1019, m: 671 },
];
const burdenMax = 1265;

const byArea = Object.keys(AREA_LABEL).map((id) => ({
  id,
  label: AREA_LABEL[id],
  items: startups.filter((s) => s.data.areas.includes(id)),
}));

const byType = Object.keys(TYPE_LABEL).map((id) => ({
  id,
  label: TYPE_LABEL[id],
  items: startups.filter((s) => s.data.type === id),
}));

// Each company is placed on the path by its "product check" tag.
const stages = PATH_STAGES.map((st) => ({ ...st, companies: startups.filter((s) => s.data.productCheck === st.id) }));
---

<Base title="Home" wide>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <g id="person">
        <circle cx="0" cy="9" r="7"></circle>
        <path d="M-9 38V28a9 9 0 0 1 18 0V38Z"></path>
      </g>
    </defs>
  </svg>

  <header class="hero">
    <div class="hero-text">
      <h1>How does women's health research become a product?</h1>
      <p class="lede">
        Follow the story from the funding gap to the early-stage companies working on it.
      </p>
      <p class="hero-links">
        <a class="btn primary" href="#gap">Start the story ↓</a>
        <a class="btn" href="#find">Skip to the companies</a>
      </p>
    </div>
  </header>

  <div class="story">
    <section class="chap" data-n="1" id="gap">
      <div class="chap-body">
        <p class="eyebrow">The gap</p>
        <h2 class="chap-h">Women's health research has long been underfunded.<sup class="ref"><a href="#home-ref-1">[1]</a><a href="#home-ref-2">[2]</a></sup></h2>
        <p class="note">Each grid is out of a different total.
          <span class="unit"><svg viewBox="0 0 14 14" class="unit-sq" aria-hidden="true"><rect width="14" height="14" rx="2" class="bar-bg" /></svg> 1 square = 1%</span></p>
        <div class="grids">
          {
            bars.slice(0, 2).map((b) => (
              <div class="grid-card">
                <div class="big-num">{b.big}</div>
                <div class="bar-of">of {b.total} <sup class="ref"><a href={`#home-ref-${b.ref}`}>[{b.ref}]</a></sup></div>
                <svg viewBox="0 0 83 337" role="img" class="waffle"
                  aria-label={`${b.parts.map((p) => `${p.label}: ${p.pct}%`).join('; ')}, out of 100% = ${b.total}`}>
                  {b.cells.map((parts, i) => {
                    const cx = (i % 5) * 17;
                    const cy = Math.floor(i / 5) * 17;
                    return (
                      <g transform={`translate(${cx} ${cy})`}>
                        <rect width="14" height="14" rx="2" class="bar-bg" />
                        {parts.map((p) => <rect x={p.x} width={p.w} height="14" rx="2" class={`bar-${p.kind} fill`} style={`transition-delay:${0.15 + i * 0.12}s`} />)}
                      </g>
                    );
                  })}
                </svg>
                <div class="bar-legend col">
                  {b.parts.map((p) => <span class={`key key-${p.kind}`}>{p.label}: <strong>{p.pct}%</strong></span>)}
                </div>
                <div class="note">{b.note}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="chap" data-n="2" id="common">
      <div class="chap-body">
        <p class="eyebrow">Why it matters</p>
        <h2 class="chap-h">Women live longer, but spend more of those years in poor health.<sup class="ref"><a href="#home-ref-3">[3]</a></sup></h2>
        <div class="tabs" data-tabs>
          <div class="tabbar" role="tablist" aria-label="Women's health in numbers">
            <button type="button" role="tab" class="tab" id="t2-1" aria-controls="p2-1" aria-selected="true">Years in poor health</button>
            <button type="button" role="tab" class="tab" id="t2-2" aria-controls="p2-2" aria-selected="false">Common conditions</button>
            <button type="button" role="tab" class="tab" id="t2-3" aria-controls="p2-3" aria-selected="false">Pregnancy deaths</button>
            <button type="button" role="tab" class="tab" id="t2-4" aria-controls="p2-4" aria-selected="false">$1 trillion</button>
          </div>

          <div class="panel on" role="tabpanel" id="p2-1" aria-labelledby="t2-1">
            <div class="panel-text">
              <div class="big">12.1 vs 9.3</div>
              <p class="one">Years a woman and a man spend in poor health, world average, 2023.<sup class="ref"><a href="#home-ref-3">[3]</a></sup></p>
              <details class="more"><summary>More</summary><p>Women live longer than men almost everywhere, and spend more years in poor health in every region and level of development the study looked at.</p></details>
            </div>
            <div class="panel-vis">
              <div class="hbars">
                {
                  poorHealth.map((r) => (
                    <div class="hb-row">
                      <span class="hb-label">{r.label}</span>
                      <span class="hb-track"><span class={`hb hb-${r.kind}`} style={`width:${(r.v / poorHealthMax) * 100}%`}></span></span>
                      <strong class="hb-val">{r.v} yrs</strong>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="p2-2" aria-labelledby="t2-2" hidden>
            <div class="panel-text">
              <p class="one lone">Women lose more years to low back pain and depression than men do.<sup class="ref"><a href="#home-ref-4">[4]</a></sup></p>
              <p class="small">Years of life lost to illness and early death per 100,000 people aged 10 and older, 2021. Leaves out conditions only one sex gets, such as gynaecological ones.</p>
            </div>
            <div class="panel-vis">
              {
                burden.map((b) => (
                  <div class="hb-group">
                    <div class="hb-name">{b.name}</div>
                    {[['Women', b.f, 'w'], ['Men', b.m, 'm']].map(([label, v, k]) => (
                      <div class="hb-row">
                        <span class="hb-label">{label}</span>
                        <span class="hb-track"><span class={`hb hb-${k === 'w' ? 'b' : 'm'}`} style={`width:${(v / burdenMax) * 100}%`}></span></span>
                        <strong class="hb-val">{v.toLocaleString('en-US')}</strong>
                      </div>
                    ))}
                  </div>
                ))
              }
            </div>
          </div>

          <div class="panel" role="tabpanel" id="p2-3" aria-labelledby="t2-3" hidden>
            <div class="panel-text">
              <div class="big">about 260,000</div>
              <p class="one">Women died during and after pregnancy and childbirth in 2023. The WHO says most could have been prevented.<sup class="ref"><a href="#home-ref-6">[6]</a></sup></p>
            </div>
            <div class="panel-vis">
              <svg viewBox="0 0 290 40" role="img" class="vis-svg people" aria-label="About 9 in 10 of these deaths were in low and lower-middle-income countries">
                {maternal.map((c) => <use href="#person" x={c.x} class={c.on ? 'bar-a' : 'bar-bg'} />)}
              </svg>
              <p class="small">About 92% were in low and lower-middle-income countries.</p>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="p2-4" aria-labelledby="t2-4" hidden>
            <div class="panel-text">
              <div class="big">$1 trillion</div>
              <p class="one">Possible yearly boost to the world economy by 2040 from closing women's health gaps.<sup class="ref"><a href="#home-ref-5">[5]</a></sup></p>
              <details class="more"><summary>More</summary><p>A World Economic Forum and McKinsey Health Institute estimate, as described by the WHO partnership PMNCH, which says it is likely too low. The same report estimates the time women spend in poor health could fall by almost two-thirds, adding about seven healthy days per woman each year.</p></details>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="chap" data-n="3" id="money">
      <div class="chap-body">
        <p class="eyebrow">The money</p>
        <h2 class="chap-h">Where does the money go, and how much reaches femtech?</h2>
        <div class="tabs" data-tabs>
          <div class="tabbar" role="tablist" aria-label="Where the money goes">
            <button type="button" role="tab" class="tab" id="t3-1" aria-controls="p3-1" aria-selected="true">The 5%</button>
            <button type="button" role="tab" class="tab" id="t3-2" aria-controls="p3-2" aria-selected="false">Femtech's share</button>
            <button type="button" role="tab" class="tab" id="t3-3" aria-controls="p3-3" aria-selected="false">Who founds it</button>
            <button type="button" role="tab" class="tab" id="t3-4" aria-controls="p3-4" aria-selected="false">What it would take</button>
          </div>

          <div class="panel on" role="tabpanel" id="p3-1" aria-labelledby="t3-1">
            <div class="panel-text">
              <div class="big">5%</div>
              <p class="one">of global research funding went to women's health in 2020. Four of those five points went to women's cancers.<sup class="ref"><a href="#home-ref-2">[2]</a></sup></p>
              <details class="more"><summary>How I split the 5%</summary><p>The source gives 4% for women's cancers and 1% for all other women-specific conditions, with a quarter of the 1% going to fertility. The 0.25% and 0.75% are my arithmetic from that.</p></details>
            </div>
            <div class="panel-vis">
              <svg viewBox={`0 0 ${SPLIT_W} 30`} role="img" class="vis-svg" aria-label="Of the 5%: women's cancers 4%, fertility 0.25%, all other women-specific conditions 0.75%">
                {split.map((f) => <rect x={f.x} y="0" width={f.w} height="30" class={`bar-${f.kind}`} />)}
              </svg>
              <div class="bar-legend col">
                {split.map((f) => <span class={`key key-${f.kind}`}><strong>{f.pct}</strong> {f.label}</span>)}
              </div>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="p3-2" aria-labelledby="t3-2" hidden>
            <div class="panel-text">
              <div class="big">about 3%</div>
              <p class="one">of all digital health investment in 2021 went to femtech, about $2.5 billion.<sup class="ref"><a href="#home-ref-2">[2]</a></sup></p>
              <details class="more"><summary>More</summary><p>Reproductive health dominates the sector. Femtech is largely funded by venture capital firms in which male partners dominate, and women's health is often dismissed as "too niche."</p></details>
            </div>
            <div class="panel-vis">
              <svg viewBox="0 0 83 337" role="img" class="waffle" aria-label="Femtech companies: 3% of all digital health investment, out of 100%">
                {femtechBar.cells.map((parts, i) => (
                  <g transform={`translate(${(i % 5) * 17} ${Math.floor(i / 5) * 17})`}>
                    <rect width="14" height="14" rx="2" class="bar-bg" />
                    {parts.map((p) => <rect x={p.x} width={p.w} height="14" rx="2" class={`bar-${p.kind} fill`} style={`transition-delay:${0.15 + i * 0.12}s`} />)}
                  </g>
                ))}
              </svg>
              <p class="small">1 square = 1%</p>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="p3-3" aria-labelledby="t3-3" hidden>
            <div class="panel-text">
              <div class="big">about 70%</div>
              <p class="one">of femtech companies were founded or co-founded by women.<sup class="ref"><a href="#home-ref-2">[2]</a></sup></p>
            </div>
            <div class="panel-vis">
              <svg viewBox="0 0 290 40" role="img" class="vis-svg people" aria-label="About 7 in 10 femtech companies were founded or co-founded by women">
                {founders.map((c) => <use href="#person" x={c.x} class={c.on ? 'bar-a' : 'bar-bg'} />)}
              </svg>
            </div>
          </div>

          <div class="panel" role="tabpanel" id="p3-4" aria-labelledby="t3-4" hidden>
            <div class="panel-text">
              <div class="big">$15.7 billion</div>
              <p class="one">New US government funding the National Academies recommend over five years.<sup class="ref"><a href="#home-ref-1">[1]</a></sup></p>
            </div>
            <div class="panel-vis">
              <svg viewBox={`0 0 ${FUND_W} 30`} role="img" class="vis-svg" aria-label="Recommended funding: $4 billion, $11.4 billion and $315 million">
                {fund.map((f) => <rect x={f.x} y="0" width={f.w} height="30" class={`bar-${f.kind}`} />)}
              </svg>
              <div class="bar-legend col">
                {fund.map((f) => <span class={`key key-${f.kind}`}><strong>{f.label}</strong> {f.what}</span>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="chap" data-n="4" id="path">
      <div class="chap-body">
        <p class="eyebrow">The path</p>
        <h2 class="chap-h">How research becomes a product</h2>
        <p class="path-cta">
          <button type="button" class="btn primary reveal-companies">Reveal where the companies sit</button>
        </p>
        <ol class="track">
          {
            stages.map((st, i) => (
              <li class={`node${st.companies.length ? ' has' : ''}`}>
                <span class="dot">{i + 1}</span>
                <span class="node-label">{st.label}</span>
                <span class="slot">
                  {st.companies.map((s) => (
                    <a class="pin" href={`${base}/startups/${s.id}/`}>
                      <strong>{s.data.name}</strong>
                      <small>{s.data.areas.map((a) => AREA_LABEL[a]).join(', ')}</small>
                    </a>
                  ))}
                  {st.companies.length === 0 && <span class="none">none yet</span>}
                </span>
              </li>
            ))
          }
        </ol>
        <p class="note">Shows where the public evidence is, not how good a company is.</p>
      </div>
    </section>

    <section class="chap" data-n="5" id="find">
      <div class="chap-body explore">
        <p class="eyebrow">The companies</p>
        <h2 class="chap-h">Explore an emerging women's health company</h2>
        <div class="seg" role="group" aria-label="Browse by">
          <button type="button" class="seg-btn" data-view="area" aria-pressed="true">By condition</button>
          <button type="button" class="seg-btn" data-view="name" aria-pressed="false">By name</button>
          <button type="button" class="seg-btn" data-view="tech" aria-pressed="false">By technology</button>
        </div>

        <div class="view" data-view="area">
          <div class="area-grid">
            {
              byArea.filter((a) => a.items.length > 0).map((a) => (
                <div class="area">
                  <h3>
                    <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={AREA_ICON[a.id]} />
                    {a.label} <span class="count">{a.items.length}</span>
                  </h3>
                  {a.items.map((s) => (
                    <a class="card" href={`${base}/startups/${s.id}/`}>
                      <strong>{s.data.name}</strong>
                      {s.data.draft && <span class="badge">Draft</span>}
                      <span class="card-sub">{s.data.technology}</span>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>
          <p class="empty-areas"><span class="note">No profiles yet:</span>
            {byArea.filter((a) => a.items.length === 0).map((a) => (
              <span class="tag"><svg class="ico sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={AREA_ICON[a.id]} />{a.label}</span>
            ))}
          </p>
          <p class="note">A company that works on one or two conditions appears under each. One that covers many is grouped under "Many conditions".</p>
        </div>

        <div class="view" data-view="name" hidden>
          <div class="card-grid">
            {
              startups.map((s) => (
                <a class="card" href={`${base}/startups/${s.id}/`}>
                  <strong>{s.data.name}</strong>
                  {s.data.draft && <span class="badge">Draft</span>}
                  <span class="card-sub">{s.data.summary}</span>
                  <span class="card-tags">{s.data.areas.map((a) => <span class="tag">{AREA_LABEL[a]}</span>)}</span>
                </a>
              ))
            }
          </div>
          {startups.length === 0 && <p class="note">No profiles yet.</p>}
        </div>
        <div class="view" data-view="tech" hidden>
          <div class="area-grid">
            {
              byType.filter((t) => t.items.length > 0).map((t) => (
                <div class="area">
                  <h3>{t.label} <span class="count">{t.items.length}</span></h3>
                  {t.items.map((s) => (
                    <a class="card" href={`${base}/startups/${s.id}/`}>
                      <strong>{s.data.name}</strong>
                      {s.data.draft && <span class="badge">Draft</span>}
                      <span class="card-sub">{s.data.technology}</span>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>
          <p class="empty-areas"><span class="note">No profiles yet:</span> {byType.filter((t) => t.items.length === 0).map((t) => <span class="tag">{t.label}</span>)}</p>
        </div>
        <p class="note"><a href={`${base}/criteria/`}>How I choose companies</a> · <a href={`${base}/glossary/`}>Glossary</a></p>
