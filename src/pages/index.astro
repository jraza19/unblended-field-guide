<script is:inline>
  (function () {
    // Browse by condition or by name.
    var btns = document.querySelectorAll('.seg-btn');
    var views = document.querySelectorAll('.explore .view');
    function show(v) {
      Array.prototype.forEach.call(btns, function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-view') === v ? 'true' : 'false'); });
      Array.prototype.forEach.call(views, function (el) { el.hidden = el.getAttribute('data-view') !== v; });
      try { history.replaceState(null, '', v === 'name' ? '#by-name' : v === 'tech' ? '#by-technology' : '#find'); } catch (e) {}
    }
    Array.prototype.forEach.call(btns, function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-view')); }); });
    if (location.hash === '#by-name') show('name');
    if (location.hash === '#by-technology') show('tech');

    // Tabs: one stat at a time.
    Array.prototype.forEach.call(document.querySelectorAll('[data-tabs]'), function (root) {
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[role=tab]'));
      var panels = tabs.map(function (t) { return document.getElementById(t.getAttribute('aria-controls')); });
      function select(i, focus) {
        tabs.forEach(function (t, n) {
          var on = n === i;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          panels[n].classList.remove('on');
          panels[n].hidden = !on;
        });
        void panels[i].offsetWidth; // let the bars grow again from zero
        panels[i].classList.add('on');
        if (focus) tabs[i].focus();
      }
      tabs.forEach(function (t, n) {
        t.addEventListener('click', function () { select(n, false); });
        t.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight') { e.preventDefault(); select((n + 1) % tabs.length, true); }
          if (e.key === 'ArrowLeft') { e.preventDefault(); select((n + tabs.length - 1) % tabs.length, true); }
        });
      });
      select(0, false);
    });

    // Reveal the companies on the path.
    var rb = document.querySelector('.reveal-companies');
    if (rb) rb.addEventListener('click', function () {
      var track = document.querySelector('.track');
      var nodes = track.querySelectorAll('.node');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.classList.add('revealed');
      rb.parentNode.hidden = true;
      // Walk along the path one stop at a time; companies appear when the walk reaches their stop.
      Array.prototype.forEach.call(nodes, function (n, i) {
        setTimeout(function () {
          n.classList.add('lit');
          track.style.setProperty('--p', String(i / (nodes.length - 1)));
        }, reduce ? 0 : 500 * i);
      });
    });

    // Colored part of the spine follows the reader down the page.
    var story = document.querySelector('.story');
    function spine() {
      var r = story.getBoundingClientRect();
      var p = (window.innerHeight * 0.6 - r.top) / r.height;
      story.style.setProperty('--prog', String(Math.max(0, Math.min(1, p))));
    }
    if (story) { spine(); window.addEventListener('scroll', spine, { passive: true }); window.addEventListener('resize', spine); }

    // Chapters fade in as you scroll to them.
    var chaps = document.querySelectorAll('.chap');
    if (!('IntersectionObserver' in window)) { Array.prototype.forEach.call(chaps, function (c) { c.classList.add('in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -12% 0px' });
    Array.prototype.forEach.call(chaps, function (c) { io.observe(c); });
  })();
</script>
