---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term, 'en', { sensitivity: 'base' }),
);
---

<Base title="Glossary">
  <h1>Glossary</h1>
  <p>
    Plain-language definitions of the technical terms used in the profiles. Each one names its source. A
    note marks any definition I have not yet checked against its source.
  </p>
  <dl>
    {
      terms.map((t) => (
        <>
          <dt id={t.id}>{t.data.term}</dt>
          <dd>
            {t.data.short}
            {!t.data.verified && <em> Not yet checked against its source.</em>}
            <br />
            <small>
              Source:{' '}
              {t.data.sources.map((s, i) => (
                <>
                  {i > 0 && '; '}
                  <a href={s.url}>{s.label}</a>
                </>
              ))}
            </small>
          </dd>
        </>
      ))
    }
  </dl>
</Base>
